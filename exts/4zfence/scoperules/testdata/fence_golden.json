[
  {
    "name": "exact host hit blocks",
    "set": "{\"enabled\":true,\"default_action\":\"record\",\"rules\":[{\"id\":\"r1\",\"action\":\"block\",\"method\":\"*\",\"host\":\"api.example.com\"}]}",
    "get": "https://api.example.com/v1/x",
    "verdict": {
      "action": "block",
      "rule_id": "r1",
      "reason": "命中测试范围规则 r1（* api.example.com）"
    },
    "judged": true
  },
  {
    "name": "subdomain covered by exact row",
